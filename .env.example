# Copy to .env (setup.sh does this for you). .env is gitignored; this file is not,
# so never put a real value here.

# The drafting, splitting, binding, critic and repair stages. Everything before
# them -- segmentation, the session index, the validators, the renderers -- runs
# without a key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only read by `server.cli jira-push`, which is the one command that sends
# anything anywhere. The Jira *export* builds an issue on disk and needs none of
# these. Never put them in config/project.yaml, which is committed.
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
