{
  "manifest_version": 3,
  "name": "AITC Recorder",
  "version": "0.1.0",
  "description": "Records a QA session as structured evidence: semantic snapshots, network metadata and outcomes, redacted in the browser.",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "downloads",
    "scripting",
    "activeTab",
    "webNavigation",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "AITC Recorder"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["content.js"]
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["mainworld.js"]
    }
  ],

  "commands": {
    "checkpoint": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Force a step boundary here"
    },
    "scenario-break": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "A new test case starts here"
    },
    "bug-marker": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Flag this session as a bug report"
    }
  }
}
